#
# For a description of the syntax of this configuration file,
# see Documentation/kbuild/kconfig-language.txt.
#
mainmenu "Linux/$ARCH $KERNELVERSION Kernel Configuration"

config SRCARCH
	string
	option env="SRCARCH"

source "arch/$SRCARCH/Kconfig"

config NO_ERROR_ON_MISMATCH
	bool "No error on symbol mismatches"
	default n
	help
	   Fix compile for some targets

config LTO
	bool
	help
	  Selected by each link time optimization option. Kbuild keys the
	  thin-archive built-in objects, the export CRC scripts kept beside
	  each object, the per-initcall sections and the relocatable vmlinux
	  prelink on this symbol; the compiler-specific option names the
	  compile flags and the linker that run the prelink.
